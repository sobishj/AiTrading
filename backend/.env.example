# ===================== Database =====================
DATABASE_URL=postgresql://aitrading:aitrading@localhost:5432/aitrading
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===================== Local LLM (LM Studio or Bionic, OpenAI-compatible) =====================
# PRD target: Qwen 3 in LM Studio (e.g. LLM_MODEL=qwen3-8b). <think> blocks are stripped.
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=qwen2.5-1.5b-instruct
# Embeddings are zero-padded to the 1536-dim column in trading_memory,
# so a smaller model (e.g. nomic at 768 dims) works fine.
LLM_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.3

# ===================== Zerodha Kite Connect =====================
KITE_API_KEY=your_kite_api_key
KITE_API_SECRET=your_kite_api_secret
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://localhost:8000/kite/callback

# ===================== CORS =====================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Where to redirect the browser back to after completing Zerodha login
FRONTEND_URL=http://localhost:5173

# ===================== App =====================
APP_ENV=development
APP_NAME=AiTrading
LOG_LEVEL=INFO
LOG_DIR=logs
SECRET_KEY=change-this-in-production

# ===================== Background job intervals (seconds) =====================
TECHNICAL_REFRESH_INTERVAL=60
# One-time seed value only, used the first time the app_settings table is
# created. After that, the live value lives in the database and is changed
# via PUT /api/settings/refresh-interval or the UI control — editing this
# .env value later has no effect. Set via the API to null to disable
# auto-refresh entirely ("never").
RANKING_REFRESH_INTERVAL=300
MARKET_CONTEXT_REFRESH_INTERVAL=900

# ===================== News =====================
# Comma-separated RSS feeds (defaults: ET Markets, ET Stocks, Livemint, Business Standard).
# Moneycontrol's RSS feeds stopped updating in April 2024 and are no longer used.
# NEWS_RSS_URLS=https://economictimes.indiatimes.com/markets/rssfeeds/1977021501.cms,...
NEWS_SCAN_INTERVAL=180

# ===================== Market data =====================
# auto = Zerodha Kite when logged in, otherwise Yahoo Finance (free, ~15 min delayed)
MARKET_DATA_PROVIDER=auto
HISTORY_DAYS=420
# Seed the watchlist with the built-in NSE large-cap universe when it is empty
SEED_WATCHLIST=true

# ===================== Schedules (IST, weekdays) =====================
MORNING_BRIEF_TIME=08:30
POST_MARKET_LEARNING_TIME=16:00

# ===================== Position sizing defaults =====================
DEFAULT_CAPITAL=100000
DEFAULT_RISK_PER_TRADE_PCT=1.0
